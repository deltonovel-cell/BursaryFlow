<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>BursaryFlow | Apply Smarter</title>

    <meta name="description"
          content="BursaryFlow helps students discover bursaries, prepare applications and manage their funding journey with intelligent tools." />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/style.css" />
</head>
<body>
    <!-- NAVIGATION -->

    <header class="navbar" id="navbar">

        <a href="/" class="brand">

            <span class="brand-mark">
                <span></span>
                <span></span>
                <span></span>
            </span>

            <span class="brand-name">
                Bursary<span>Flow</span>
            </span>

        </a>

        <nav class="nav-links" id="navLinks">

            <a href="#features">
                Features
            </a>

            <a href="#how-it-works">
                How it works
            </a>

            <a href="/BursaryPage">
                Bursaries
            </a>

            <a href="#security">
                Security
            </a>

            <a href="#about">
                About
            </a>

        </nav>

        <div class="nav-actions">

            <a href="/Account/Login"
               class="login-link">
                Log in
            </a>

            <a href="/Account/Register"
               class="nav-register">
                Get started
                <span>→</span>
            </a>

        </div>

        <button class="mobile-menu"
                id="mobileMenu"
                type="button"
                aria-label="Open navigation">

            <span></span>
            <span></span>
            <span></span>

        </button>

    </header>


    <main>

        <!-- HERO -->

        <section class="hero">

            <div class="hero-background">

                <div class="hero-glow hero-glow-one"></div>

                <div class="hero-glow hero-glow-two"></div>

                <div class="hero-grid"></div>

                <div class="hero-orbit orbit-one"></div>

                <div class="hero-orbit orbit-two"></div>

            </div>

            <div class="hero-content">

                <div class="hero-eyebrow">

                    <span class="live-dot"></span>

                    INTELLIGENT BURSARY ASSISTANCE

                </div>

                <h1>

                    Stop searching.
                    <br />

                    <span>Start applying.</span>

                </h1>

                <p class="hero-description">

                    BursaryFlow helps you discover funding opportunities,
                    prepare your documents and manage your applications
                    from one intelligent platform.

                </p>

                <div class="hero-actions">

                    <a href="/Account/Register"
                       class="primary-button">

                        Create free account

                        <span>→</span>

                    </a>

                    <a href="#how-it-works"
                       class="secondary-button">

                        See how it works

                        <span class="play-icon">
                            ▶
                        </span>

                    </a>

                </div>

                <div class="hero-proof">

                    <div class="proof-avatars">

                        <span>DL</span>
                        <span>TM</span>
                        <span>NK</span>
                        <span>+</span>

                    </div>

                    <div>

                        <strong>
                            Built for students
                        </strong>

                        <small>
                            Find funding without the frustration.
                        </small>

                    </div>

                </div>

            </div>


            <!-- PRODUCT PREVIEW -->

            <div class="hero-product">

                <div class="product-window">

                    <div class="window-header">

                        <div class="window-controls">

                            <span></span>
                            <span></span>
                            <span></span>

                        </div>

                        <div class="window-title">

                            <span class="window-ai-dot"></span>

                            BursaryFlow

                        </div>

                        <div class="window-status">
                            ● Live
                        </div>

                    </div>


                    <div class="product-body">

                        <aside class="product-sidebar">

                            <div class="mini-brand">
                                BF
                            </div>

                            <div class="mini-nav active">
                                <span>⌂</span>
                            </div>

                            <div class="mini-nav">
                                <span>⌕</span>
                            </div>

                            <div class="mini-nav">
                                <span>□</span>
                            </div>

                            <div class="mini-nav">
                                <span>✓</span>
                            </div>

                        </aside>


                        <div class="product-main">

                            <div class="product-top">

                                <div>

                                    <span class="product-label">
                                        YOUR DASHBOARD
                                    </span>

                                    <h3>
                                        Find your next opportunity.
                                    </h3>

                                </div>

                                <div class="product-avatar">
                                    D
                                </div>

                            </div>


                            <div class="match-summary">

                                <div>

                                    <span>
                                        PROFILE MATCH
                                    </span>

                                    <strong>
                                        94%
                                    </strong>

                                    <small>
                                        Your profile is ready.
                                    </small>

                                </div>

                                <div class="match-ring">
                                    <div>
                                        ✓
                                    </div>
                                </div>

                            </div>


                            <div class="preview-grid">

                                <div class="preview-card">

                                    <div class="preview-card-top">

                                        <span>
                                            AI ASSISTANT
                                        </span>

                                        <b>
                                            ✦
                                        </b>

                                    </div>

                                    <h4>
                                        Your profile is looking good.
                                    </h4>

                                    <p>
                                        Complete your documents to improve
                                        your application readiness.
                                    </p>

                                    <div class="mini-progress">

                                        <span></span>

                                    </div>

                                </div>


                                <div class="preview-card document-preview-card">

                                    <div class="document-symbol">
                                        ✓
                                    </div>

                                    <span>
                                        DOCUMENTS
                                    </span>

                                    <strong>
                                        4 / 5 ready
                                    </strong>

                                    <small>
                                        One document needs attention.
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="floating-ai-card">

                    <div class="floating-ai-icon">
                        ✦
                    </div>

                    <div>

                        <span>
                            DELTON AI
                        </span>

                        <strong>
                            Document checked
                        </strong>

                        <small>
                            No obvious issues detected.
                        </small>

                    </div>

                    <div class="floating-check">
                        ✓
                    </div>

                </div>


                <div class="floating-notification">

                    <span class="notification-icon">
                        !
                    </span>

                    <div>

                        <strong>
                            Application reminder
                        </strong>

                        <small>
                            Keep your deadlines organised.
                        </small>

                    </div>

                </div>

            </div>

        </section>


        <!-- STATS -->

        <section class="stats-section">

            <div class="stat-item">

                <div class="stat-icon">
                    ◎
                </div>

                <div>

                    <strong>
                        One profile
                    </strong>

                    <span>
                        Your information in one place
                    </span>

                </div>

            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">

                <div class="stat-icon">
                    ✦
                </div>

                <div>

                    <strong>
                        Smart matching
                    </strong>

                    <span>
                        Find opportunities that fit
                    </span>

                </div>

            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">

                <div class="stat-icon">
                    □
                </div>

                <div>

                    <strong>
                        Better applications
                    </strong>

                    <span>
                        Prepare before you submit
                    </span>

                </div>

            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">

                <div class="stat-icon">
                    ◷
                </div>

                <div>

                    <strong>
                        Deadline awareness
                    </strong>

                    <span>
                        Stay ahead of important dates
                    </span>

                </div>

            </div>

        </section>


        <!-- FEATURES -->

        <section class="features-section"
                 id="features">

            <div class="section-heading">

                <div class="section-label">

                    <span>01</span>

                    WHAT BURSARYFLOW DOES

                </div>

                <h2>
                    Everything you need to
                    <em>apply smarter.</em>
                </h2>

                <p>
                    BursaryFlow brings discovery, preparation and
                    application management together in one place.
                </p>

            </div>


            <div class="feature-grid">

                <article class="feature-card feature-card-large">

                    <div class="feature-card-number">
                        01
                    </div>

                    <div class="feature-icon purple">
                        ✦
                    </div>

                    <h3>
                        Intelligent bursary matching
                    </h3>

                    <p>
                        Build your student profile once and discover
                        opportunities based on your academic information,
                        study path and eligibility.
                    </p>

                    <div class="feature-demo">

                        <div class="demo-row">

                            <span>
                                Computer Science
                            </span>

                            <b>
                                ✓
                            </b>

                        </div>

                        <div class="demo-row">

                            <span>
                                University of Johannesburg
                            </span>

                            <b>
                                ✓
                            </b>

                        </div>

                        <div class="demo-row">

                            <span>
                                Academic profile
                            </span>

                            <b>
                                ✓
                            </b>

                        </div>

                    </div>

                </article>


                <article class="feature-card">

                    <div class="feature-card-number">
                        02
                    </div>

                    <div class="feature-icon blue">
                        □
                    </div>

                    <h3>
                        Document assistance
                    </h3>

                    <p>
                        Upload important documents and prepare them
                        before you submit an application.
                    </p>

                    <div class="feature-mini-document">

                        <div class="mini-doc-line"></div>
                        <div class="mini-doc-line short"></div>
                        <div class="mini-doc-line"></div>

                        <span>
                            ✓ Ready
                        </span>

                    </div>

                </article>


                <article class="feature-card">

                    <div class="feature-card-number">
                        03
                    </div>

                    <div class="feature-icon green">
                        ✓
                    </div>

                    <h3>
                        Application preparation
                    </h3>

                    <p>
                        Keep your information organised and know
                        what you need before applying.
                    </p>

                    <div class="feature-check-list">

                        <span>
                            ✓ Profile complete
                        </span>

                        <span>
                            ✓ Documents ready
                        </span>

                        <span>
                            ✓ Application prepared
                        </span>

                    </div>

                </article>


                <article class="feature-card">

                    <div class="feature-card-number">
                        04
                    </div>

                    <div class="feature-icon orange">
                        ◷
                    </div>

                    <h3>
                        Deadline awareness
                    </h3>

                    <p>
                        Keep track of important application dates
                        and avoid unnecessary last-minute pressure.
                    </p>

                    <div class="deadline-demo">

                        <span>
                            APPLICATION
                        </span>

                        <strong>
                            Deadline approaching
                        </strong>

                        <div class="deadline-line">
                            <span></span>
                        </div>

                    </div>

                </article>

            </div>

        </section>


        <!-- HOW IT WORKS -->

        <section class="how-section"
                 id="how-it-works">

            <div class="section-heading centered">

                <div class="section-label">

                    <span>02</span>

                    HOW IT WORKS

                </div>

                <h2>
                    From profile to
                    <em>opportunity.</em>
                </h2>

                <p>
                    BursaryFlow turns a complicated process into
                    a simple journey.
                </p>

            </div>


            <div class="steps">

                <div class="step">

                    <div class="step-number">
                        01
                    </div>

                    <div class="step-icon">
                        +
                    </div>

                    <h3>
                        Create your profile
                    </h3>

                    <p>
                        Add your academic and personal information once.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">
                        02
                    </div>

                    <div class="step-icon">
                        ✦
                    </div>

                    <h3>
                        Discover opportunities
                    </h3>

                    <p>
                        Find bursaries that fit your profile and goals.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">
                        03
                    </div>

                    <div class="step-icon">
                        □
                    </div>

                    <h3>
                        Prepare your application
                    </h3>

                    <p>
                        Organise documents and check your application.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">
                        04
                    </div>

                    <div class="step-icon">
                        ✓
                    </div>

                    <h3>
                        Apply with confidence
                    </h3>

                    <p>
                        Submit and keep track of your application journey.
                    </p>

                </div>

            </div>

        </section>


        <!-- AI DOCUMENT SECTION -->

        <section class="ai-section">

            <div class="ai-copy">

                <div class="section-label light">

                    <span>03</span>

                    SMART DOCUMENTS

                </div>

                <h2>
                    Your documents.
                    <br />
                    <em>Understood.</em>
                </h2>

                <p>
                    Preparing an application can be stressful.
                    BursaryFlow helps you identify potential issues
                    before you submit.
                </p>

                <div class="ai-benefits">

                    <div class="ai-benefit">

                        <span>
                            01
                        </span>

                        <div>

                            <strong>
                                Document quality
                            </strong>

                            <p>
                                Identify documents that may be
                                difficult to read.
                            </p>

                        </div>

                    </div>


                    <div class="ai-benefit">

                        <span>
                            02
                        </span>

                        <div>

                            <strong>
                                Information assistance
                            </strong>

                            <p>
                                Extract useful information from
                                supported documents.
                            </p>

                        </div>

                    </div>


                    <div class="ai-benefit">

                        <span>
                            03
                        </span>

                        <div>

                            <strong>
                                Consistency checks
                            </strong>

                            <p>
                                Flag information that may need
                                your attention.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <div class="scanner-area">

                <div class="scanner-card">

                    <div class="scanner-header">

                        <div>

                            <span>
                                DOCUMENT ANALYSIS
                            </span>

                            <strong>
                                Identity Document
                            </strong>

                        </div>

                        <div class="scanner-status">
                            ●
                        </div>

                    </div>


                    <div class="scanner-document">

                        <div class="fake-photo">
                            D
                        </div>

                        <div class="fake-information">

                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>

                        </div>

                        <div class="scanner-beam"></div>

                    </div>


                    <div class="scanner-results">

                        <div class="scan-result">

                            <span class="result-success">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Document readable
                                </strong>

                                <small>
                                    Image quality looks good
                                </small>

                            </div>

                        </div>


                        <div class="scan-result">

                            <span class="result-success">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Information detected
                                </strong>

                                <small>
                                    Relevant fields identified
                                </small>

                            </div>

                        </div>


                        <div class="scan-result warning">

                            <span class="result-warning">
                                !
                            </span>

                            <div>

                                <strong>
                                    Review suggested
                                </strong>

                                <small>
                                    Check your information
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- SECURITY -->

        <section class="security-section"
                 id="security">

            <div class="security-visual">

                <div class="security-orb">

                    <div class="security-ring ring-one"></div>

                    <div class="security-ring ring-two"></div>

                    <div class="security-lock">
                        ✓
                    </div>

                </div>

                <div class="security-floating-card">

                    <span>
                        BURSARYFLOW
                    </span>

                    <strong>
                        Privacy matters.
                    </strong>

                    <small>
                        Your information stays under your control.
                    </small>

                </div>

            </div>


            <div class="security-copy">

                <div class="section-label">

                    <span>04</span>

                    YOUR INFORMATION

                </div>

                <h2>
                    Built with your
                    <em>privacy in mind.</em>
                </h2>

                <p>
                    Student information and documents can be sensitive.
                    BursaryFlow is designed around responsible handling
                    of the information you choose to provide.
                </p>

                <div class="security-list">

                    <div>
                        <span>✓</span>
                        Controlled document access
                    </div>

                    <div>
                        <span>✓</span>
                        Secure account management
                    </div>

                    <div>
                        <span>✓</span>
                        Application activity visibility
                    </div>

                    <div>
                        <span>✓</span>
                        Account and data controls
                    </div>

                </div>

            </div>

        </section>


        <!-- CTA -->

        <section class="cta-section"
                 id="about">

            <div class="cta-glow"></div>

            <div class="cta-content">

                <div class="section-label light">

                    <span>05</span>

                    YOUR NEXT STEP

                </div>

                <h2>
                    Ready to stop
                    <em>searching?</em>
                </h2>

                <p>
                    Create your BursaryFlow profile and start building
                    a smarter funding journey.
                </p>

                <div class="cta-buttons">

                    <a href="/Account/Register"
                       class="primary-button">

                        Create my account

                        <span>→</span>

                    </a>

                    <a href="/Account/Login"
                       class="cta-login">

                        Already have an account?

                        <strong>
                            Log in
                        </strong>

                    </a>

                </div>

            </div>

        </section>

    </main>


