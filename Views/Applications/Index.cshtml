@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>


    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>BursaryFlow | My Applications</title>

    <meta name="description"
          content="Track and manage your bursary applications with BursaryFlow." />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.googleapis.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/dashboard.css" />

    <link rel="stylesheet"
          href="~/css/applications.css" />
    ```

</head>

<body>

    <div class="dashboard-shell">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="sidebar"
               id="sidebar">


            <div class="sidebar-brand">

                <a href="/Dashboard"
                   class="brand">

                    <span class="brand-mark">

                        <span></span>
                        <span></span>
                        <span></span>

                    </span>

                    <span>
                        Bursary<span>Flow</span>
                    </span>

                </a>

            </div>


            <!-- PROFILE -->

            <div class="sidebar-profile">

                <div class="profile-avatar">
                    D
                </div>

                <div class="profile-details">

                    <strong>
                        Delton
                    </strong>

                    <span>
                        Student
                    </span>

                </div>

                <button class="profile-menu"
                        type="button">

            

                </button>

            </div>


            <!-- NAVIGATION -->

            <nav class="sidebar-navigation">


                <div class="navigation-label">
                    WORKSPACE
                </div>


                <!-- DASHBOARD -->

                <a href="/Dashboard"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="layout-dashboard"></i>

                    </span>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- FIND BURSARIES -->

                <a href="/BursaryPage"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="search"></i>

                    </span>

                    <span>
                        Find bursaries
                    </span>

                    <span class="sidebar-count">
                        0
                    </span>

                </a>


                <!-- MY APPLICATIONS - ACTIVE -->

                <a href="/Applications"
                   class="sidebar-link active">

                    <span class="sidebar-icon">

                        <i data-lucide="send"></i>

                    </span>

                    <span>
                        My applications
                    </span>

                </a>


                <!-- DOCUMENTS -->

                <a href="/Documents"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="folder"></i>

                    </span>

                    <span>
                        Documents
                    </span>

                </a>


                <div class="navigation-label">
                    TOOLS
                </div>


                <!-- PROFILE -->

                <a href="/Profile"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="user-round"></i>

                    </span>

                    <span>
                        My profile
                    </span>

                </a>


                <!-- AI -->

                <a href="/AiAssistant"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="sparkles"></i>

                    </span>

                    <span>
                        AI assistant
                    </span>

                    <span class="ai-badge">
                        AI
                    </span>

                </a>


                <!-- CREATE DOCUMENT -->

                <a href="/Documents/Create"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="file-plus-2"></i>

                    </span>

                    <span>
                        Create document
                    </span>

                </a>


                <div class="navigation-label">
                    ACCOUNT
                </div>


                <!-- SETTINGS -->

                <a href="/Settings"
                   class="sidebar-link">

                    <span class="sidebar-icon">

                        <i data-lucide="settings"></i>

                    </span>

                    <span>
                        Settings
                    </span>

                </a>


            </nav>


            <!-- SIDEBAR BOTTOM -->

            <div class="sidebar-bottom">


                <div class="help-card">

                    <div class="help-icon">

                        <i data-lucide="circle-help"></i>

                    </div>

                    <div>

                        <strong>
                            Need help?
                        </strong>

                        <span>
                            Ask BursaryFlow AI
                        </span>

                    </div>

                </div>


                <a href="/Account/Logout"
                   class="logout-link">

                    <i data-lucide="log-out"></i>

                    <span>
                        Sign out
                    </span>

                </a>


            </div>


        </aside>


        <!-- =====================================================
             MAIN
             ===================================================== -->

        <main class="dashboard-main">


            <!-- HEADER -->

            <header class="dashboard-header">


                <button class="mobile-menu"
                        id="mobileMenu"
                        type="button"
                        aria-label="Open navigation">

                    <i data-lucide="menu"></i>

                </button>


                <!-- SEARCH -->

                <div class="header-search">

                    <i data-lucide="search"></i>

                    <input type="text"
                           id="globalSearch"
                           placeholder="Search bursaries, applications or documents..." />

                    <span class="search-shortcut">
                        /
                    </span>

                </div>


                <!-- HEADER ACTIONS -->

                <div class="header-actions">


                    <button class="header-icon-button"
                            type="button"
                            title="Notifications">

                        <i data-lucide="bell"></i>

                        <span class="notification-dot"></span>

                    </button>


                    <div class="header-divider"></div>


                    <button class="header-user"
                            type="button">

                        <span class="header-avatar">
                            D
                        </span>

                        <span class="header-user-name">
                            Delton
                        </span>

                        <i data-lucide="chevron-down"></i>

                    </button>


                </div>


            </header>


            <!-- =================================================
                 CONTENT
                 ================================================= -->

            <div class="dashboard-content applications-content">


                <!-- HERO -->

                <section class="applications-hero">


                    <div>


                        <div class="hero-eyebrow">

                            <span></span>

                            APPLICATION CENTRE

                        </div>


                        <h1>

                            Your
                            <em>applications.</em>

                        </h1>


                        <p>

                            Keep track of every bursary application,
                            deadline and submission in one place.

                        </p>


                    </div>


                    <a href="/BursaryPage"
                       class="primary-action">

                        <i data-lucide="plus"></i>

                        Find a bursary

                    </a>


                </section>


                <!-- =================================================
                     STATISTICS
                     ================================================= -->

                <section class="application-stats">


                    <!-- TOTAL -->

                    <div class="application-stat-card">


                        <div class="stat-icon">

                            <i data-lucide="files"></i>

                        </div>


                        <div>

                            <span>
                                TOTAL
                            </span>

                            <strong id="totalApplications">
                                0
                            </strong>

                        </div>


                    </div>


                    <!-- IN PROGRESS -->

                    <div class="application-stat-card">


                        <div class="stat-icon">

                            <i data-lucide="pen-line"></i>

                        </div>


                        <div>

                            <span>
                                IN PROGRESS
                            </span>

                            <strong id="inProgress">
                                0
                            </strong>

                        </div>


                    </div>


                    <!-- SUBMITTED -->

                    <div class="application-stat-card">


                        <div class="stat-icon">

                            <i data-lucide="send"></i>

                        </div>


                        <div>

                            <span>
                                SUBMITTED
                            </span>

                            <strong id="submitted">
                                0
                            </strong>

                        </div>


                    </div>


                    <!-- SUCCESSFUL -->

                    <div class="application-stat-card">


                        <div class="stat-icon">

                            <i data-lucide="circle-check"></i>

                        </div>


                        <div>

                            <span>
                                SUCCESSFUL
                            </span>

                            <strong id="successful">
                                0
                            </strong>

                        </div>


                    </div>


                </section>


                <!-- =================================================
                     APPLICATION SECTION
                     ================================================= -->

                <section class="applications-section">


                    <!-- SECTION HEADER -->

                    <div class="applications-section-header">


                        <div>

                            <span class="section-label">
                                TRACKING
                            </span>

                            <h2>
                                My applications
                            </h2>

                        </div>


                        <!-- SEARCH -->

                        <div class="application-search">

                            <i data-lucide="search"></i>

                            <input type="text"
                                   id="applicationSearch"
                                   placeholder="Search applications..." />

                        </div>


                    </div>


                    <!-- =================================================
                         FILTERS
                         ================================================= -->

                    <div class="application-filters">


                        <button class="application-filter active"
                                data-status="all"
                                type="button">

                            All

                        </button>


                        <button class="application-filter"
                                data-status="draft"
                                type="button">

                            Draft

                        </button>


                        <button class="application-filter"
                                data-status="progress"
                                type="button">

                            In progress

                        </button>


                        <button class="application-filter"
                                data-status="submitted"
                                type="button">

                            Submitted

                        </button>


                        <button class="application-filter"
                                data-status="successful"
                                type="button">

                            Successful

                        </button>


                        <button class="application-filter"
                                data-status="unsuccessful"
                                type="button">

                            Unsuccessful

                        </button>


                    </div>


                    <!-- =================================================
                         APPLICATION LIST
                         ================================================= -->

                    <div id="applicationsList"
                         class="applications-list">
                    </div>


                    <!-- =================================================
                         EMPTY STATE
                         ================================================= -->

                    <div id="emptyApplications"
                         class="applications-empty hidden">


                        <div class="empty-application-icon">

                            <i data-lucide="file-search"></i>

                        </div>


                        <h3>
                            No applications yet
                        </h3>


                        <p>

                            Start exploring bursaries and save
                            your first application here.

                        </p>


                        <a href="/BursaryPage"
                           class="primary-action">

                            Find bursaries

                            <i data-lucide="arrow-right"></i>

                        </a>


                    </div>


                </section>


            </div>


        </main>


    </div>


    <!-- =========================================================
         LUCIDE ICONS
         ========================================================= -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- APPLICATION JAVASCRIPT -->

    <script src="~/js/applications.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                if (typeof lucide !== "undefined") {

                    lucide.createIcons();

                }

            }
        );

    </script>


</body>

</html>
