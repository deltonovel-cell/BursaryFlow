    <!-- =========================================================
         LUCIDE
         ========================================================= -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =========================================================
         CREATE DOCUMENT JAVASCRIPT
         ========================================================= -->

    <script src="~/js/createdocument.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                if (typeof lucide !== "undefined") {

                    lucide.createIcons();

                }

                const paper = document.getElementById("documentPaper");

                const wordCount = document.getElementById("wordCount");

                const titleInput =
                    document.getElementById("documentTitle");

                const editorTitle =
                    document.getElementById("editorTitle");


                function updateWordCount() {

                    if (!paper || !wordCount) {
                        return;
                    }

                    const text =
                        paper.innerText
                            .trim()
                            .replace(/\s+/g, " ");

                    if (!text) {

                        wordCount.textContent =
                            "0 words";

                        return;

                    }

                    const words =
                        text.split(" ").filter(Boolean).length;

                    wordCount.textContent =
                        words + (words === 1 ? " word" : " words");

                }


                if (paper) {

                    paper.addEventListener(
                        "input",
                        updateWordCount
                    );

                }


                if (titleInput && editorTitle) {

                    titleInput.addEventListener(
                        "input",
                        function () {

                            editorTitle.textContent =
                                this.value.trim() ||
                                "Untitled document";

                        }
                    );

                }


                document
                    .querySelectorAll("[data-command]")
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                "click",
                                function () {

                                    const command =
                                        this.dataset.command;

                                    document.execCommand(
                                        command,
                                        false,
                                        null
                                    );

                                    if (paper) {
                                        paper.focus();
                                    }

                                }
                            );

                        }
                    );


                const undoButton =
                    document.getElementById("undoButton");

                const redoButton =
                    document.getElementById("redoButton");


                if (undoButton) {

                    undoButton.addEventListener(
                        "click",
                        function () {

                            document.execCommand(
                                "undo",
                                false,
                                null
                            );

                            if (paper) {
                                paper.focus();
                            }

                        }
                    );

                }


                if (redoButton) {

                    redoButton.addEventListener(
                        "click",
                        function () {

                            document.execCommand(
                                "redo",
                                false,
                                null
                            );

                            if (paper) {
                                paper.focus();
                            }

                        }
                    );

                }


                document
                    .querySelectorAll(".document-type")
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                "click",
                                function () {

                                    document
                                        .querySelectorAll(".document-type")
                                        .forEach(
                                            function (item) {

                                                item.classList.remove(
                                                    "active"
                                                );

                                            }
                                        );

                                    this.classList.add("active");

                                    const type =
                                        this.dataset.type;

                                    const title =
                                        document.getElementById(
                                            "documentTitle"
                                        );

                                    if (!title) {
                                        return;
                                    }

                                    const titles = {

                                        motivation:
                                            "Bursary Motivation Letter",

                                        personal:
                                            "Personal Statement",

                                        email:
                                            "Bursary Application Email",

                                        response:
                                            "Bursary Application Response",

                                        custom:
                                            "My Bursary Document"

                                    };

                                    title.value =
                                        titles[type] ||
                                        "My Bursary Document";

                                    if (editorTitle) {

                                        editorTitle.textContent =
                                            title.value;

                                    }

                                }
                            );

                        }
                    );


                const saveButton =
                    document.getElementById("saveDocument");

                const status =
                    document.getElementById("documentStatus");


                if (saveButton) {

                    saveButton.addEventListener(
                        "click",
                        function () {

                            if (status) {

                                status.textContent =
                                    "Saved just now";

                            }

                            saveButton.classList.add(
                                "saved"
                            );

                            setTimeout(
                                function () {

                                    saveButton.classList.remove(
                                        "saved"
                                    );

                                },
                                1500
                            );

                        }
                    );

                }


                const generateButton =
                    document.getElementById(
                        "generateDocument"
                    );


                if (generateButton) {

                    generateButton.addEventListener(
                        "click",
                        function () {

                            const original =
                                this.innerHTML;

                            this.innerHTML =

                                '<span class="generate-icon">' +
                                '<i data-lucide="loader-circle"></i>' +
                                '</span>' +
                                '<span>' +
                                '<strong>Delton is writing...</strong>' +
                                '<small>Creating your document</small>' +
                                '</span>';

                            this.classList.add(
                                "generating"
                            );

                            if (typeof lucide !== "undefined") {
                                lucide.createIcons();
                            }


                            setTimeout(
                                function () {

                                    generateButton.innerHTML =
                                        original;

                                    generateButton.classList.remove(
                                        "generating"
                                    );

                                    if (typeof lucide !== "undefined") {
                                        lucide.createIcons();
                                    }

                                    if (status) {

                                        status.textContent =
                                            "Generated by Delton";

                                    }

                                },
                                1800
                            );

                        }
                    );

                }


                const improveButton =
                    document.getElementById(
                        "improveDocument"
                    );


                if (improveButton) {

                    improveButton.addEventListener(
                        "click",
                        function () {

                            if (!paper) {
                                return;
                            }

                            const paragraph =
                                document.createElement(
                                    "p"
                                );

                            paragraph.innerHTML =
                                "<strong>Delton's suggestion:</strong> " +
                                "Consider adding a specific example " +
                                "of an academic achievement, personal " +
                                "challenge or career goal to make this " +
                                "motivation more personal and memorable.";

                            paper
                                .querySelector(".paper-content")
                                .appendChild(
                                    paragraph
                                );

                            updateWordCount();

                        }
                    );

                }


                updateWordCount();

            }
        );

    </script>

</body>

</html>