    <!-- LUCIDE ICONS -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                lucide.createIcons();

                loadRecommendedBursaries();

                setupMobileNavigation();

                setupSearch();

            }
        );


        async function loadRecommendedBursaries() {

            const container =
                document.getElementById(
                    "recommendedBursaries"
                );

            try {

                const response =
                    await fetch(
                        "/api/Bursary"
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to retrieve bursaries."
                    );

                }


                const result =
                    await response.json();


                let bursaries = [];


                if (Array.isArray(result)) {

                    bursaries = result;

                }
                else if (Array.isArray(result.data)) {

                    bursaries = result.data;

                }
                else if (Array.isArray(result.bursaries)) {

                    bursaries = result.bursaries;

                }


                if (bursaries.length === 0) {

                    container.innerHTML = `

                        <div class="empty-state">

                            <div class="empty-icon">
                                <i data-lucide="search-x"></i>
                            </div>

                            <strong>
                                No matches yet
                            </strong>

                            <p>
                                Complete your profile so we can
                                find bursaries suitable for you.
                            </p>

                            <a href="/Profile"
                               class="button-secondary">

                                Complete profile

                            </a>

                        </div>

                    `;

                    lucide.createIcons();

                    return;

                }


                const recommended =
                    bursaries.slice(0, 3);


                container.innerHTML =
                    recommended
                        .map(
                            bursary =>
                                createBursaryCard(
                                    bursary
                                )
                        )
                        .join("");


                lucide.createIcons();


                const count =
                    document.getElementById(
                        "bursaryCount"
                    );

                if (count) {

                    count.textContent =
                        bursaries.length;

                }


                const matches =
                    document.getElementById(
                        "matchesCount"
                    );

                if (matches) {

                    matches.textContent =
                        bursaries.length;

                }

            }
            catch (error) {

                console.error(
                    "Bursary loading error:",
                    error
                );


                container.innerHTML = `

                    <div class="empty-state error">

                        <div class="empty-icon">
                            <i data-lucide="wifi-off"></i>
                        </div>

                        <strong>
                            Couldn't load bursaries
                        </strong>

                        <p>
                            Make sure the BursaryFlow API
                            is running and try again.
                        </p>

                        <button
                            type="button"
                            onclick="loadRecommendedBursaries()"
                            class="button-secondary">

                            Try again

                        </button>

                    </div>

                `;

                lucide.createIcons();

            }

        }


        function createBursaryCard(bursary) {

            const id =
                bursary.bursaryID ??
                bursary.BursaryID ??
                0;


            const name =
                bursary.bursaryName ??
                bursary.BursaryName ??
                "Bursary opportunity";


            const provider =
                bursary.providerName ??
                bursary.ProviderName ??
                "Verified provider";


            const studyLevel =
                bursary.studyLevel ??
                bursary.StudyLevel ??
                "Various study levels";


            const minimumAverage =
                bursary.minimumAverage ??
                bursary.MinimumAverage;


            let requirement =
                studyLevel;


            if (minimumAverage !== null &&
                minimumAverage !== undefined) {

                requirement =
                    `${studyLevel} · ${minimumAverage}% minimum`;

            }


            return `

                <article class="bursary-match-card">

                    <div class="bursary-provider-logo">

                        ${escapeHtml(
                            provider
                                .substring(0, 2)
                                .toUpperCase()
                        )}

                    </div>


                    <div class="bursary-match-content">

                        <div class="bursary-match-heading">

                            <div>

                                <span class="verified-label">

                                    <i data-lucide="badge-check"></i>

                                    Verified opportunity

                                </span>

                                <h3>
                                    ${escapeHtml(name)}
                                </h3>

                                <p>
                                    ${escapeHtml(provider)}
                                </p>

                            </div>


                            <span class="match-percentage">
                                Match
                            </span>

                        </div>


                        <div class="bursary-tags">

                            <span>
                                <i data-lucide="graduation-cap"></i>
                                ${escapeHtml(requirement)}
                            </span>

                        </div>


                        <div class="bursary-match-actions">

                            <a href="/Bursary/Details/${id}"
                               class="text-button">

                                View details

                                <i data-lucide="arrow-right"></i>

                            </a>


                            <a href="/Application/Create?bursaryId=${id}"
                               class="small-primary-button">

                                Apply

                                <i data-lucide="arrow-up-right"></i>

                            </a>

                        </div>

                    </div>

                </article>

            `;

        }


        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";

            }


            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function setupMobileNavigation() {

            const menu =
                document.getElementById(
                    "mobileMenu"
                );

            const sidebar =
                document.getElementById(
                    "sidebar"
                );

            const overlay =
                document.getElementById(
                    "sidebarOverlay"
                );


            function toggleSidebar() {

                sidebar.classList.toggle(
                    "mobile-visible"
                );

                overlay.classList.toggle(
                    "visible"
                );

            }


            menu?.addEventListener(
                "click",
                toggleSidebar
            );


            overlay?.addEventListener(
                "click",
                toggleSidebar
            );

        }


        function setupSearch() {

            const search =
                document.getElementById(
                    "globalSearch"
                );


            search?.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Enter" &&
                        search.value.trim()
                    ) {

                        window.location.href =
                            "/Bursary?search=" +
                            encodeURIComponent(
                                search.value.trim()
                            );

                    }

                }
            );

        }


        document
            .querySelectorAll(
                "[data-ai-action]"
            )
            .forEach(
                button => {

                    button.addEventListener(
                        "click",
                        function () {

                            const action =
                                this.dataset.aiAction;


                            if (
                                action === "matches"
                            ) {

                                window.location.href =
                                    "/Bursary";

                            }
                            else if (
                                action === "documents"
                            ) {

                                window.location.href =
                                    "/Documents";

                            }
                            else if (
                                action === "application"
                            ) {

                                window.location.href =
                                    "/Applications";

                            }

                        }
                    );

                }
            );

    </script>

</body>

</html>

